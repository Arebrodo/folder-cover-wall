{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "moduleResolution": "Bundler",
    "importHelpers": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "lib": ["DOM", "ES2018"]
  },
  "include": ["src/**/*.ts"]
}
